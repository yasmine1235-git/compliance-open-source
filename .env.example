# Copy to .env to override defaults. Never commit .env.

# API
COMPLIANCEOPS_MAX_UPLOAD_BYTES=52428800

# Ingestion and search. Changing the model means deleting and rebuilding the collections.
# Docker Compose sets the Qdrant URL itself, so this value only applies outside Docker.
COMPLIANCEOPS_QDRANT_URL=http://localhost:6333
# Faster default. For higher quality on a larger download, use BAAI/bge-m3.
COMPLIANCEOPS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Langfuse (local only). Replace all three for anything other than local development:
#   openssl rand -base64 32
LANGFUSE_DB_PASSWORD=local-dev-only
LANGFUSE_NEXTAUTH_SECRET=local-dev-only
LANGFUSE_SALT=local-dev-only
