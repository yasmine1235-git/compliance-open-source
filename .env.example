# Copy to .env to override defaults. Never commit .env.

# API
COMPLIANCEOPS_MAX_UPLOAD_BYTES=52428800

# Langfuse (local only). Replace all three for anything other than local development:
#   openssl rand -base64 32
LANGFUSE_DB_PASSWORD=local-dev-only
LANGFUSE_NEXTAUTH_SECRET=local-dev-only
LANGFUSE_SALT=local-dev-only
